.table { margin-top: 24px; color: #24332a; font-size: 16px; overflow-wrap: anywhere; }
.heading { font-size: 21px; font-weight: 600; }
.hint { color: #728075; font-size: 14px; margin-top: 4px; }
.tier { background: #fff; padding: 18px; border: 1px solid #e4eae2; border-radius: 16px; margin-top: 12px; }
.tier-name { font-weight: 600; }
.grid { display: flex; flex-wrap: wrap; gap: 16px 12px; margin-top: 10px; }
.cell { width: calc(50% - 6px); min-width: 0; }
.price { font-size: 20px; word-break: break-all; }
.rules { margin-top: 16px; padding: 16px; background: #eaf1e8; border-radius: 12px; color: #516957; font-size: 14px; }
.rules view { margin-bottom: 8px; }
