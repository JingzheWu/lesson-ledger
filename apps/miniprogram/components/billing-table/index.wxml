<view class="table">
  <view class="heading">{{title}}</view><view class="hint">一对一基础单价 · 元 / 小时</view>
  <view wx:for="{{table}}" wx:key="id" class="tier"><view class="tier-name">{{item.name}}</view><view class="grid"><view wx:for="{{item.prices}}" wx:for-item="price" wx:key="id" class="cell"><view class="hint">{{price.name}}</view><view class="price">{{price.value}}</view></view></view></view>
  <view class="rules"><view>每节固定 {{rules.hoursPerLesson}} 小时；班型系数仅影响费用，不改变阶梯工时。</view><view wx:for="{{rules.classes}}" wx:key="id">{{item.name}}：{{item.numerator / item.denominator}}</view><view>{{rules.sorting}}</view><view>{{rules.rounding}}</view></view>
</view>
