<view class="table">
  <view class="heading export-node" data-export-text="{{title}}">{{title}}</view><view class="hint export-node" data-export-text="一对一基础单价 · 元 / 小时">一对一基础单价 · 元 / 小时</view>
  <view wx:for="{{table}}" wx:key="id" class="tier export-node"><view class="tier-name export-node" data-export-text="{{item.name}}">{{item.name}}</view><view class="grid"><view wx:for="{{item.prices}}" wx:for-item="price" wx:key="id" class="cell"><view class="hint export-node" data-export-text="{{price.name}}">{{price.name}}</view><view class="price export-node" data-export-text="{{price.value}}">{{price.value}}</view></view></view></view>
  <view class="rules export-node"><view class="export-node" data-export-text="每节固定 {{rules.hoursPerLesson}} 小时；班型系数仅影响费用，不改变阶梯工时。">每节固定 {{rules.hoursPerLesson}} 小时；班型系数仅影响费用，不改变阶梯工时。</view><view wx:for="{{rules.classes}}" wx:key="id" class="export-node" data-export-text="{{item.name}}：{{item.numerator / item.denominator}}">{{item.name}}：{{item.numerator / item.denominator}}</view><view class="export-node" data-export-text="{{rules.sorting}}">{{rules.sorting}}</view><view class="export-node" data-export-text="{{rules.rounding}}">{{rules.rounding}}</view></view>
</view>
