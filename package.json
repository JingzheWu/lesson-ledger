{
  "name": "lesson-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm build:web && pnpm build:wechat",
    "build:web": "tsc -b && vite build",
    "build:wechat": "tsc -p tsconfig.wechat.json && node scripts/build-wechat.mjs",
    "check:wechat": "node scripts/check-wechat.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "esbuild": "0.25.9",
    "wx-server-sdk": "4.0.2"
  },
  "packageManager": "pnpm@10.14.0"
}
